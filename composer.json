{
    "name": "musicall/gestione-scuola-musica",
    "description": "Sistema di gestione per scuole di musica con calendario settimanale",
    "type": "project",
    "license": "proprietary",
    "version": "2.4.1",
    "require": {
        "php": ">=7.4",
        "illuminate/database": "^9.0|^10.0",
        "illuminate/events": "^9.0|^10.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "MusicAll\\": "app/"
        },
        "files": [
            "includes/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}